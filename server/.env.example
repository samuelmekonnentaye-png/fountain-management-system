# ===== Copy these into the "Environment" settings of your online host (Render). Never commit a real .env file. =====
NODE_ENV=production
# Render sets PORT by itself - leave it out online. Locally the default is 5000.
# PORT=5000

# MongoDB Atlas connection string (put the database name before the "?")
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/fountain_work_plan?retryWrites=true&w=majority

# A long random secret (48+ characters). Create one:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=PUT-A-LONG-RANDOM-SECRET-HERE
JWT_EXPIRES_IN=1d

# The address of the website (Vercel). Several addresses can be separated by commas. No trailing slash.
CLIENT_URL=https://your-app.vercel.app

# New accounts always wait for the System Admin. Set to false to close self-registration completely.
ALLOW_REGISTRATION=true

# Optional: e-mail copies of reports (leave SMTP_HOST empty to disable)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="FOUNTAIN INTERNATIONAL TRADING PLC <no-reply@yourcompany.com>"
